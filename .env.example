# SwasthyaSetu AI - Environment Configuration Example
# Copy this file to .env.local for local testing (never commit .env.local to Git)

# TinyFish Public Health Web Discovery API Key (Server-Side Only)
TINYFISH_API_KEY=sk-tinyfish-FPRLZfu7d0aDuOXZJegkhuP4Wm3LzV0I

# LLM Provider Configuration (Server-Side Only)
# Supported providers: 'gemini', 'openai', 'groq'
# If LLM_API_KEY is left blank, SwasthyaSetu AI seamlessly runs on its built-in
# Grounded Knowledge Engine without crashing or hallucinating.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
